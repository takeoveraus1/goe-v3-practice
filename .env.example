# Where the database lives. A local SQLite file by default.
# For production, point this at a hosted libSQL/Turso database, e.g. libsql://your-db.turso.io
# (Vercel's Turso integration sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN instead – both work.)
DATABASE_URL=file:./data/goe.db
# Only needed for hosted libSQL/Turso databases.
DATABASE_AUTH_TOKEN=

# Secret used to sign login sessions. Generate one with: openssl rand -base64 32
# Optional on a hosted database with a token (a key is derived from it); required otherwise in production.
SESSION_SECRET=replace-me-with-a-long-random-string

# Fallback time zone used to work out "today" before the browser reports its own.
APP_TIMEZONE=Australia/Sydney

# Demo mode (on unless set to false): one-click demo logins on the login page, and
# the demo athletes are loaded into an empty hosted database on deploy.
# Set to false before real athletes use the app.
DEMO_MODE=true

# Site-wide access code: everyone must enter it before seeing anything (even the login page).
# On Vercel the app stays locked until this is set. Locally it's off unless you set it.
ACCESS_CODE=
